DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/acme_salary

# Application database only. pytest derives the test connection from this URL
# (same driver, credentials, host, port, and query; database name acme_test).
# Create PostgreSQL database acme_test once. pytest does not CREATE/DROP it.
# Ordinary Alembic and FastAPI keep using DATABASE_URL. Never point this at
# acme_test. Do not commit a real .env file.

# Configured HR Manager identity recorded on salary audit events. Not a login.
HR_MANAGER_IDENTITY=hr-manager

# HR Manager login username. Distinct from HR_MANAGER_IDENTITY.
HR_MANAGER_USERNAME=replace_with_login_username

# Argon2id hash of the HR Manager password. Never store the plaintext password.
# The placeholder below is invalid; replace it before running the application
# or startup configuration will fail. Generate a hash:
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
HR_MANAGER_PASSWORD_HASH=replace_with_a_generated_argon2_hash

# Session cookie and lifetime. SESSION_COOKIE_SECURE must be true for HTTPS.
# false is for local HTTP development only. Default lifetime is 8 hours (28800).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

# HMAC secret for session-bound CSRF tokens. Required. Distinct from the HR
# password hash. Never reuse a production secret in tests or commit a real value.
CSRF_SIGNING_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Exact frontend origins allowed to POST /api/v1/auth/login. JSON array of
# scheme://host or scheme://host:port values with no path or wildcard.
# Colons in the URL are not escaped. Configure the real frontend origin
# before browser integration; login CSRF cannot use a session.
CSRF_TRUSTED_ORIGINS=["https://replace-with-frontend-origin"]