DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/acme_salary

# Application database only. pytest derives the test connection from this URL
# (same driver, credentials, host, port, and query; database name acme_test).
# Create PostgreSQL database acme_test once. pytest does not CREATE/DROP it.
# Ordinary Alembic and FastAPI keep using DATABASE_URL. Never point this at
# acme_test. Do not commit a real .env file.

# Control-plane Alembic only. Application Settings and backend/alembic.ini do
# not read this variable. It must not target acme_salary or acme_test: the
# guard compares host, port, and database name with DATABASE_URL,
# TEST_DATABASE_URL, and the derived acme_test URL. The database name below
# is a local placeholder, not a production name. This does not choose
# credentials, privilege separation, or a control-plane test database.
# Do not copy this key into .env.compose. Check the revision head from the
# repository root; this command does not connect or apply migrations:
#   .\.venv\Scripts\python.exe -m alembic -c backend\alembic-control-plane.ini heads
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/acme_control_plane

# Configured HR Manager identity recorded on salary audit events. Not a login.
HR_MANAGER_IDENTITY=hr-manager

# HR Manager login username. Distinct from HR_MANAGER_IDENTITY.
HR_MANAGER_USERNAME=replace_with_login_username

# Argon2id hash of the HR Manager password. Never store the plaintext password
# in git. The placeholder below is invalid; replace it before running the
# application or startup configuration will fail. Choose a local password,
# then generate a hash (PowerShell, from the repository root after installing
# requirements.txt):
#   .\.venv\Scripts\python.exe -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
# Login uses HR_MANAGER_USERNAME plus that plaintext password. There is no
# shared demo password in this repository.
HR_MANAGER_PASSWORD_HASH=replace_with_a_generated_argon2_hash

# Session cookie and lifetime. SESSION_COOKIE_SECURE must be true for HTTPS.
# false is for local HTTP development only. Default lifetime is 8 hours (28800).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

# HMAC secret for session-bound CSRF tokens. Required. Distinct from the HR
# password hash. Never reuse a production secret in tests or commit a real value.
CSRF_SIGNING_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Exact frontend origins allowed to POST /api/v1/auth/login. JSON array of
# scheme://host or scheme://host:port values with no path or wildcard.
# Colons in the URL are not escaped. Configure the real frontend origin
# before browser integration; login CSRF cannot use a session.
# Local Vite: http://localhost:5173. Local Compose (same-origin):
# http://localhost:8000. compose.yaml overrides the app container to that
# Compose origin; do not use this file to weaken CSRF checks.
CSRF_TRUSTED_ORIGINS=["https://replace-with-frontend-origin"]

# Compose PostgreSQL only (compose.yaml). If .env already exists, append
# these three keys; do not replace DATABASE_URL, TEST_DATABASE_URL, or
# other host application settings. Compose interpolates them into the
# app container DATABASE_URL host "db" (not localhost). Port 5432 is not
# published, so this is not the host acme_salary or acme_test database.
# POSTGRES_DB may be named acme_salary inside Compose; that is a different
# server from localhost:5432/acme_salary. Use an alphanumeric password
# (avoid @ : / $) so the URL does not need encoding. Placeholders only.
# Copy HR Manager and CSRF keys into Git-ignored .env.compose for the app
# container; do not put TEST_DATABASE_URL or host DATABASE_URL there.
# In .env.compose, wrap the Argon2 hash in single quotes so Compose does not
# treat $... fragments as variable interpolation.
POSTGRES_USER=acme
POSTGRES_PASSWORD=replace_with_local_compose_password
POSTGRES_DB=acme_salary
